<%- include('../partials/head',{meta}) %>
<div class="admin-shell login-shell">
  <form class="login-card" method="post" action="/admin/login">
    <div class="brand admin-brand"><img class="admin-logo" src="/images/ctn-logo.webp" alt="Capital Trust News"><span><strong>සංස්කාරක CMS</strong><small>පුවත් කළමනාකරණ පද්ධතිය</small></span></div>
    <h1>සංස්කාරක පිවිසුම</h1>
    <% if(error){ %><div class="alert error"><%= error %></div><% } %>
    <label>පරිශීලක නාමය<input name="username" autocomplete="username" required></label>
    <label>මුරපදය<input type="password" name="password" autocomplete="current-password" required></label>
    <button class="button primary" type="submit">පිවිසෙන්න</button>
    <a href="/" class="muted-link">← වෙබ් අඩවියට ආපසු</a>
  </form>
</div>
</body></html>
