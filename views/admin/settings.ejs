<%- include('../partials/head',{meta}) %>
<div class="admin-layout">
  <%- include('sidebar') %>
  <main class="admin-main"><div class="admin-top"><div><span class="eyebrow">සැකසුම්</span><h1>වෙබ් අඩවි සැකසුම්</h1><p class="admin-intro">Code එක edit නොකර site name, menu categories සහ top ticker තොරතුරු වෙනස් කරන්න.</p></div></div><form method="post" action="/admin/settings" class="admin-card settings-form"><div class="two-col"><label>වෙබ් අඩවි නාමය<input name="siteName" value="<%= settings.siteName %>"></label><label>කෙටි නාමය<input name="siteShortName" value="<%= settings.siteShortName %>"></label></div><label>Tagline<input name="tagline" value="<%= settings.tagline %>"></label><label>Categories <small>internal category keys comma වලින් වෙන් කරන්න; menu එකේ සිංහල නාම ස්වයංක්‍රීයව පෙන්වයි</small><textarea name="categories" rows="3"><%= (settings.categories||[]).join(', ') %></textarea></label><label>Footer පෙළ<textarea name="footerText" rows="2"><%= settings.footerText %></textarea></label><h3>ඉහළ දත්ත Ticker</h3><p class="help">ASPI, exchange rate හෝ වෙනත් කෙටි දත්ත code නොමැතිව මෙතැනින් වෙනස් කරන්න.</p><% [0,1,2].forEach((idx)=>{ const t=(settings.tickerItems||[])[idx]||{}; %><div class="two-col"><label>Label <%= idx+1 %><input name="tickerLabel<%= idx+1 %>" value="<%= t.label||'' %>"></label><label>Value <%= idx+1 %><input name="tickerValue<%= idx+1 %>" value="<%= t.value||'' %>"></label></div><% }) %><button class="button primary" type="submit">සැකසුම් සුරකින්න</button></form></main>
</div>
</body></html>
